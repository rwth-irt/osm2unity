 <node id="6864116004" visible="true" version="6" changeset="162532762" timestamp="2025-02-15T11:34:33Z" user="aixbrick" uid="3298438" lat="50.7849811" lon="6.0752179">
  <tag k="historic" v="memorial"/>
  <tag k="image" v="File:WgdV - Aachen, Rütscherstraße.JPG"/>
  <tag k="inscription" v="Als das Ende des Krieges schon abzusehen war, harrte in diesem Bunker der letzte Kampfkommandant der Wehrmacht in Aachen gemäß den nationalsozialistischen Befehlen aus. Dieses Verhalten kostete noch in der letzten Kriegswoche vom 5. bis 21. Oktober 1944 v"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:ref" v="15"/>
  <tag k="name" v="Kriegsende"/>
  <tag k="network" v="Wege gegen das Vergessen"/>
  <tag k="website" v="http://www.wgdv.de/wege/ruetscherstr"/>
  <tag k="wikimedia_commons" v="Category:Wege gegen das Vergessen"/>
 </node>
 <node id="6884763760" visible="true" version="5" changeset="162532762" timestamp="2025-02-15T11:34:33Z" user="aixbrick" uid="3298438" lat="50.7823180" lon="6.0821431">
  <tag k="historic" v="memorial"/>
  <tag k="image" v="File:WgdV -Aachen, Marienturm (alt) Aachen XV.jpg"/>
  <tag k="inscription" v="Nach Planungen noch in der Weimarer Republik weihte am 6. August 1933 der national- sozialistische Aachener Oberbürgermeister dieses „Ehrenmal“ für die deutschen Gefallenen des 1. Weltkrieges ein. Der militaristische Geist jener Jahre prägt dieses Bauwerk"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:ref" v="4"/>
  <tag k="name" v="Militarismus"/>
  <tag k="network" v="Wege gegen das Vergessen"/>
  <tag k="website" v="http://www.wgdv.de/wege/marienburg"/>
 </node>
 <node id="6884799744" visible="true" version="5" changeset="162532762" timestamp="2025-02-15T11:34:33Z" user="aixbrick" uid="3298438" lat="50.7818801" lon="6.0796341">
  <tag k="historic" v="memorial"/>
  <tag k="image" v="File:WgdV - Aachen, Bunker Saarstraße.jpg"/>
  <tag k="inscription" v="Aachen wurde im September 1944 auf Anordnung der Nazis zwangsweise geräumt. Johann Herren und Karl Schwartz, beide 14 Jahre alt, wurden in der Stadt von Wehrmachtssoldaten willkürlich unter dem Vorwurf der „Plünderung“ festgenommen. Ein Standgericht verur"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:ref" v="14"/>
  <tag k="name" v="Mord an zwei Kindern"/>
  <tag k="network" v="Wege gegen das Vergessen"/>
  <tag k="website" v="http://www.wgdv.de/wege/bunkersaarstr"/>
 </node>
