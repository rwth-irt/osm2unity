  <tag k="historic" v="memorial"/>
  <tag k="image" v="https://commons.wikimedia.org/wiki/File:WgdV_-_Aachen,_Bergdriesch_39.jpg"/>
  <tag k="inscription" v="Seit 1928 stand an diesem Ort die jüdische Schule. Als 1938 die Kinder jüdischen Glaubens von den städtischen Schulen gewiesen wurden, war dies die einzige Schule, die jüdische Kinder besuchen durften. Im Zuge der Deportationen wurde sie aufgelöst"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:ref" v="6"/>
  <tag k="name" v="Jüdische Schule"/>
  <tag k="network" v="Wege gegen das Vergessen"/>
  <tag k="website" v="http://www.wgdv.de/wege/bergdriesch__39"/>
 </node>
 <node id="1659336877" visible="true" version="12" changeset="162532762" timestamp="2025-02-15T11:34:33Z" user="aixbrick" uid="3298438" lat="50.7854609" lon="6.0757737">
  <tag k="historic" v="memorial"/>
  <tag k="image" v="File:WgdV - Aachen, Försterstraße 28.JPG"/>
  <tag k="inscription" v="Dieses Haus wurde als „Judenhaus“ für Ehepaare in so genannter „Mischehe“ eingerichtet. Zum 1. April 1941 setzte der Rat der Stadt Aachen damit die Weisung der NS-Führung zur Ghettoisierung der jüdischen Bevölkerung um. Andere „Judenhäuser“ standen in der"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:ref" v="42"/>
  <tag k="name" v="&quot;Judenhaus&quot;"/>
  <tag k="network" v="Wege gegen das Vergessen"/>
  <tag k="website" v="http://www.wgdv.de/wege/foersterstrasse_28"/>
 </node>
